# CCA-F 실습 환경 변수 예시 — 복사해서 .env 로 쓰고 실제 키를 채운다.
# ⚠️ .env 및 실제 키는 절대 커밋하지 말 것 (.gitignore 로 제외됨)

# Bedrock 리전 (서울)
AWS_REGION=ap-northeast-2

# 지급받은 Bedrock API 키(bearer token). Claude 구독 불필요.
AWS_BEARER_TOKEN_BEDROCK=

# 실습용 모델 (리전별 교차추론 프로파일 ID — 콘솔에서 정확한 값 확인)
# 스모크 테스트 기본값은 haiku, 실제 실습은 sonnet 권장.
BEDROCK_MODEL_ID=apac.anthropic.claude-3-haiku-20240307-v1:0
# ANTHROPIC_MODEL=apac.anthropic.claude-sonnet-4-...

# (Tier 2, Claude Code/Agent SDK 쓸 때만) settings.json 에도 동일 설정
CLAUDE_CODE_USE_BEDROCK=1
